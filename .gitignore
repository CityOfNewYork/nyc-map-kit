.claude/
__pycache__/
*.pyc
.DS_Store
node_modules/
data/*.pmtiles
# The Protomaps basemap, cut by build/protomaps.sh (about 150 MB)
app/public/*.pmtiles
# Clash Grotesk, fetched by build/clash-grotesk.sh; its license allows self-hosting, not
# redistribution
app/public/fonts/ClashGrotesk-*.woff2

# Raw source exports carry organization contact emails; the sanitized CSV is the committed source
data/*.kml
data/*.xlsx

# Internal planning notes — not part of the handoff/shareable repo
internal/

# Build output
dist/
coverage/

# Local keys, read by Vite (app/.env.local). See app/.env.example.
.env*
!.env.example
