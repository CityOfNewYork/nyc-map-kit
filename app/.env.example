# Copy to app/.env.local (git-ignored) and fill in. Vite reads it at dev and build time.
#
# A Geoclient subscription key from https://api-portal.nyc.gov (product: geoclient-v2-user).
# It ends up in the built JavaScript, where anyone can read it: use a key for this site only.
# Without it, the search box finds boroughs, neighborhoods and ZIP codes but not addresses.
VITE_GEOCLIENT_KEY=
